---
import Base from "../layouts/Base.astro";
import { messages } from "../i18n/messages";

const photos = [
  // Best shots first
  { src: "/gallery/wood_work3.png", key: "gallery.woodwork3" },
  { src: "/gallery/Temple_Front_Enhanced.png", key: "gallery.front" },
  { src: "/gallery/Front_view.png", key: "gallery.frontView" },
  { src: "/gallery/Image1.png", key: "gallery.duskView" },
  { src: "/gallery/wood_work.png", key: "gallery.woodwork" },
  { src: "/gallery/wood_work2.png", key: "gallery.woodwork2" },
  { src: "/gallery/Image3.png", key: "gallery.mantapaView" },

  // Exterior and courtyard
  { src: "/gallery/temple-courtyard_enhanced.png", key: "gallery.courtyard" },
  { src: "/gallery/temple-side.png", key: "gallery.exterior" },
  { src: "/gallery/Entrance.png", key: "gallery.entranceView" },
  { src: "/gallery/Front_View_2.png", key: "gallery.tulabhara" },
  { src: "/gallery/Front_View_3.png", key: "gallery.decorated" },
  { src: "/gallery/temple-back.png", key: "gallery.back" },

  // Sanctum and shrines
  { src: "/gallery/garbhagudi.png", key: "gallery.garbha" },
  { src: "/gallery/temple-close.png", key: "gallery.close" },
  { src: "/gallery/theertha-mantapa.png", key: "gallery.mantapa" },
  { src: "/gallery/theertha_mantapa_evening.jpeg", key: "gallery.mantapaEvening" },

  // Deities
  { src: "/gallery/deity_image_hd.jpeg", key: "gallery.deity" },
  { src: "/gallery/deity_image.png", key: "gallery.deityClose" },
  { src: "/gallery/diety_image_kavacha.jpeg", key: "gallery.deityKavacha" },
  { src: "/gallery/deity_image_kavacha2.jpeg", key: "gallery.deityKavacha2" },
  { src: "/gallery/ganapathi.png", key: "gallery.ganapathi" },
  { src: "/gallery/shasthara.png", key: "gallery.shasthara" },
  { src: "/gallery/muni.png", key: "gallery.muni" },

  // Murals
  { src: "/gallery/vishwaroopa.png", key: "gallery.vishwaroopa" },
  { src: "/gallery/vishwaroopa2.png", key: "gallery.vishwaroopa2" },
  { src: "/gallery/krisha_flute.png", key: "gallery.krishnaMural" },

  // Festival and pond
  { src: "/gallery/Jaatre2.png", key: "gallery.jatrotsava" },
  { src: "/gallery/utsava_murthy.jpeg", key: "gallery.utsavaMurthy" },
  { src: "/gallery/Pond_Enhanced.png", key: "gallery.pond" },
  { src: "/gallery/pond_at_night.png", key: "gallery.pondNight" },
];
---

<Base title="Gallery" titleKey="meta.gallery" description="Photographs of Sri Gopalakrishna Temple, Bilinele.">
  <section class="wrap page">
    <header class="page-intro">
      <p class="kicker" data-i18n="nav.gallery">Gallery</p>
      <h1 data-i18n="gallery.title">Photo gallery</h1>
    </header>
    <div class="masonry">
      {photos.map((photo) => (
        <figure>
          <button class="shot" type="button" data-lightbox-open aria-label={messages.en[photo.key]} data-i18n={photo.key} data-i18n-attr="aria-label">
            <img src={photo.src} alt={messages.en[photo.key]} data-i18n={photo.key} data-i18n-attr="alt" loading="lazy" />
          </button>
          <figcaption data-i18n={photo.key}>{messages.en[photo.key]}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <dialog class="lightbox" data-lightbox>
    <button class="lightbox-close" type="button" data-lightbox-close data-i18n="gallery.closeBtn">Close</button>
    <img alt="" />
    <p></p>
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
    const image = dialog?.querySelector("img");
    const caption = dialog?.querySelector("p");
    document.querySelectorAll<HTMLButtonElement>("[data-lightbox-open]").forEach((button) => {
      button.addEventListener("click", () => {
        const source = button.querySelector("img");
        if (!dialog || !image || !source) return;
        image.src = source.src;
        image.alt = source.alt;
        if (caption) caption.textContent = button.parentElement?.querySelector("figcaption")?.textContent ?? source.alt;
        dialog.showModal();
      });
    });
    dialog?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  </script>
</Base>
