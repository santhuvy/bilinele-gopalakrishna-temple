---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { templePhone, templePhoneHref } from "../data/sevas";
import { members, officers, phoneHref } from "../data/committee";

const roleLabel = {
  president: "President",
  secretary: "Secretary",
  member: "Members",
} as const;
---

<Base title="Contact" titleKey="meta.visit" description="Contact Sri Gopalakrishna Temple, Bilinele. Management committee from 2025, temple phone 08251-262299, Nettana post, Kadaba taluk.">
  <section class="wrap page">
    <header class="page-intro">
      <p class="kicker" data-i18n="visit.plan">Plan your visit</p>
      <h1 data-i18n="contact.title">Contact us</h1>
      <p data-i18n="footer.address">{site.address.lines.join(", ")}</p>
    </header>
    <div class="scan-grid">
      <article class="scan-card">
        <span data-i18n="pooja.title">Pooja times</span>
        <p><span data-i18n="pooja.morningLabel">Morning</span> <strong data-i18n="pooja.morning">8:00–8:30</strong></p>
        <p><span data-i18n="pooja.noonLabel">Afternoon</span> <strong data-i18n="pooja.noon">12:00–12:30</strong></p>
        <p><span data-i18n="pooja.eveningLabel">Evening</span> <strong data-i18n="pooja.evening">7:00–7:15</strong></p>
      </article>
      <article class="scan-card">
        <span data-i18n="fact.place">Place</span>
        <strong data-i18n="fact.placeValue">Bilinele, Kadaba taluk</strong>
        <p data-i18n="fact.placeDetail">Dakshina Kannada, Karnataka</p>
      </article>
      <article class="scan-card">
        <span data-i18n="visit.title">How to reach the temple</span>
        <p data-i18n="visit.line3">Nettana post, Kadaba taluk</p>
        <p><a class="text-link" href="#reach" data-i18n="visit.address">Address</a></p>
      </article>
      <article class="scan-card">
        <span data-i18n="nav.visit">Contact</span>
        <a class="phone" href={templePhoneHref}>{templePhone}</a>
      </article>
    </div>

    <div class="section-block">
      <h2 data-i18n="contact.committee">Management committee from 2025</h2>
      <div class="cards">
        {
          officers.map((person) => (
            <article class="card">
              <span data-i18n={person.role === "secretary" ? "contact.secretary" : "contact.president"}>{roleLabel[person.role ?? "member"]}</span>
              <h3 class="kn-name">{person.kn}</h3>
              <p class="en-name">{person.en}</p>
              {person.place && (
                <p class="person-place">
                  <span class="kn-name">{person.place}</span>
                  <span class="en-name">{person.placeEn}</span>
                </p>
              )}
              <p><a class="phone" href={phoneHref(person.phone)}>{person.phone}</a></p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="section-block">
      <h2 data-i18n="contact.members">Members</h2>
      <div class="seva-wrap">
        <table class="seva-table">
          <thead>
            <tr>
              <th data-i18n="contact.colName">Name</th>
              <th data-i18n="contact.colPhone">Phone</th>
            </tr>
          </thead>
          <tbody>
            {
              members.map((person) => (
                <tr>
                  <td>
                    <span class="kn-name">{person.kn}</span>
                    <span class="en-name">{person.en}</span>
                  </td>
                  <td><a href={phoneHref(person.phone)}>{person.phone}</a></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="section-block reach" id="reach">
      <h2 data-i18n="visit.title">How to reach the temple</h2>
      <p data-i18n="visit.lede">
        The temple is in Bilinele village, Kadaba taluk, Dakshina Kannada, on the Kadaba–Subrahmanya road. Devotees travelling from Bengaluru can use the Bengaluru–Mangaluru railway route. Kukke Subramanya Road is a nearby station, and the temple can be reached by road from there.
      </p>
      <div class="reach-grid">
        <div>
          <h3 data-i18n="visit.address">Address</h3>
          <address>
            <strong data-i18n="visit.line1">Sri Gopalakrishna Temple</strong>
            <span data-i18n="visit.line2">Bilinele</span>
            <span data-i18n="visit.line3">Nettana post, Kadaba taluk</span>
            <span data-i18n="visit.line4">Dakshina Kannada</span>
            <span data-i18n="visit.line5">Karnataka 574238</span>
            <span data-i18n="visit.line6">India</span>
          </address>
          <p class="reach-phone">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 7a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
            <a href={templePhoneHref}>{templePhone}</a>
          </p>
        </div>
        <iframe
          class="reach-map"
          title="Map of Sri Gopalakrishna Temple, Bilinele"
          data-i18n="visit.mapTitle"
          data-i18n-attr="title"
          src={site.mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p><a class="button" href={site.mapHref} target="_blank" rel="noreferrer" data-i18n="visit.directions">Get Directions</a></p>
    </div>
  </section>
</Base>
